{
  "name": "gep-land-model-viewer-frontend",
  "version": "0.0.0",
  "description": "CDP Frontend Template",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:frontend": "NODE_ENV=production webpack",
    "dev": "AWS_EMF_ENVIRONMENT=Local run-p frontend:watch server:watch",
    "dev:debug": "AWS_EMF_ENVIRONMENT=Local run-p frontend:watch server:debug",
    "docker:dev": "npm run dev",
    "format": "eslint . --fix",
    "frontend:watch": "NODE_ENV=development webpack --watch",
    "git:pre-commit-hook": "npm run security-audit && npm run lint && npm test",
    "postinstall": "npm run setup:husky",
    "lint": "run-s lint:js lint:scss",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "test": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest",
    "typecheck": "npx -y -p typescript tsc --noEmit -p jsconfig.json",
    "security-audit": "npm audit --audit-level=high",
    "server:watch": "nodemon --exec \"node --env-file-if-exists=.env --inspect=0.0.0.0\" --ext js,json --legacy-watch ./src",
    "server:debug": "nodemon --exec \"node --env-file-if-exists=.env --inspect-brk=0.0.0.0\" --ext js,json --legacy-watch ./src",
    "prestart": "npm run build:frontend",
    "start": "NODE_ENV=production node --use-strict .",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-cognito-identity": "3.1075.0",
    "@defra/cdp-auditing": "0.6.1",
    "@defra/cdp-metrics": "0.6.0",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@defra/interactive-map": "0.0.35-alpha",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/accept": "6.0.3",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/catbox-redis": "7.0.2",
    "@hapi/cookie": "12.0.1",
    "@hapi/hapi": "21.4.9",
    "@hapi/inert": "7.1.2",
    "@hapi/jwt": "3.2.4",
    "@hapi/scooter": "8.0.0",
    "@hapi/vision": "7.0.3",
    "@hapi/yar": "11.0.3",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "cssnano": "8.0.2",
    "cssnano-preset-default": "8.0.2",
    "date-fns": "4.4.0",
    "global-agent": "3.0.0",
    "govuk-frontend": "6.2.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "3.0.1",
    "ioredis": "5.11.1",
    "lodash": "4.18.1",
    "node-fetch": "3.3.2",
    "nunjucks": "3.2.4",
    "ol": "10.9.0",
    "openid-client": "6.8.4",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "proj4": "2.20.9",
    "semver": "7.8.5",
    "undici": "8.5.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.7",
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1",
    "@vitest/coverage-v8": "4.1.9",
    "autoprefixer": "10.5.2",
    "babel-loader": "10.1.1",
    "cheerio": "1.2.0",
    "copy-webpack-plugin": "14.0.0",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "neostandard": "0.13.0",
    "nodemon": "3.1.14",
    "npm-run-all2": "8.0.4",
    "postcss-load-config": "6.0.1",
    "postcss-loader": "8.2.1",
    "sass-embedded": "1.100.0",
    "sass-loader": "17.0.0",
    "source-map-loader": "5.0.0",
    "stylelint": "17.14.0",
    "stylelint-config-gds": "3.0.0",
    "terser-webpack-plugin": "5.6.1",
    "vitest": "4.1.9",
    "vitest-fetch-mock": "0.4.5",
    "webpack": "5.107.2",
    "webpack-assets-manifest": "6.5.2",
    "webpack-cli": "7.0.3"
  },
  "overrides": {
    "tmp": "0.2.5",
    "serialize-javascript": "7.0.5",
    "uuid": "^14.0.0",
    "sirv": "^3.0.2",
    "polygon-splitter": {
      "glob": "^11.1.0",
      "brace-expansion": "5.0.8"
    },
    "brace-expansion": "5.0.8",
    "minimatch": "^10.2.6"
  }
}
