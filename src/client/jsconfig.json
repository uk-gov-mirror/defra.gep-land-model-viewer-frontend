{
  "compilerOptions": {
    "checkJs": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "react": [
        "../../node_modules/preact/compat/src/index.d.ts"
      ],
      "react-dom": [
        "../../node_modules/preact/compat/src/index.d.ts"
      ]
    },
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "./**/*",
    "../vitest.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
